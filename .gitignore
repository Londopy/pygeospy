secrets.json
api_keys.txt

# DEM / raster data (can be very large)
*.tif
*.tiff
*.img
*.nc

# Cache
.cache/
# NOTE: the runtime API cache lives outside the repo (platform-native dir,
# see pygeospy/_cache.py) so it needs no ignore rule here.

